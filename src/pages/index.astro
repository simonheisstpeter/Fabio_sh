---
import Layout from "../layouts/default.astro";
import HeroGlass, { type HeroVariant } from "../components/HeroGlass.astro";
import Marquee from "../components/Marquee.astro";

import ContactForm from "../components/ContactForm.astro";
import MiniMosaic from "../components/MiniMosaic.astro";
import ProjectTeaser from "../components/projects/ProjectTeaser.astro";
import { getTranslations } from "../i18n/index";
import { getAllProjects } from "../lib/db";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";

// /?hero=1..8 previews the other hero compositions on the live page
const heroParam = Number(Astro.url.searchParams.get("hero"));
const heroVariant = ([1, 2, 3, 4, 5, 6, 7, 8].includes(heroParam) ? heroParam : 7) as HeroVariant;

const previewProjects = getAllProjects()
    .filter((p) => p.published && !p.finished && p.online)
    .slice(0, 4);
---

<Layout title="fabio.sh" description="Fabio Gschweidl – digital media & IT">
    <!-- 00 // HERO -->
    <HeroGlass t={t} variant={heroVariant} />

    <!-- marquee strip -->
    <div class="mt-20 md:mt-32">
        <Marquee
            items={[
                "fabio.sh",
                "digital media & IT",
                "web development",
                "design",
                "self-hosting",
                "Vienna, AT",
            ]}
        />
    </div>

    <!-- 01 // PROJECTS -->
    <div id="projects" class="container mx-auto px-4 md:px-12 mt-20 md:mt-32 scroll-mt-24">
        <div class="glass px-corner p-6 md:p-10">
        <div class="section-head">
            <MiniMosaic />
            <span class="idx">01 //</span>
            <h2 class="h-display text-3xl md:text-5xl">{t.menuProjects}</h2>
        </div>
        <ProjectTeaser projects={previewProjects} locale={locale} t={t} plain />
        </div>
    </div>

    <!-- tiled divider between the major sections -->
    <div class="divider-tiles my-20 md:my-32" aria-hidden="true"></div>

    <!-- 02 // CONTACT -->
    <section
        id="contact"
        class="container mx-auto px-4 md:px-12 pb-32 scroll-mt-24"
        aria-labelledby="contact-heading"
    >
        <div class="glass px-corner p-6 md:p-10">
        <div class="section-head">
            <MiniMosaic />
            <span class="idx">02 //</span>
            <h2 id="contact-heading" class="h-display text-3xl md:text-5xl">
                {t.contactTitle}
            </h2>
        </div>

        <ContactForm t={t} sent={sent} error={error} />
        </div>
    </section>

    <!-- sunset stripe: the one block-gradient brand moment on the index page -->
    <div class="sunset-stripe" aria-hidden="true"></div>
</Layout>
