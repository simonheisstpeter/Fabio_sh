---
import Layout from "../layouts/default.astro";
import Hero from "../components/Hero.astro";

import ContactForm from "../components/ContactForm.astro";
import ProjectTeaser from "../components/projects/ProjectTeaser.astro";
import { getTranslations } from "../i18n/index";
import { getAllProjects } from "../lib/db";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";

const isJa = locale === "ja";

const previewProjects = getAllProjects()
    .filter((p) => p.published && !p.finished && p.online)
    .slice(0, 4);
---

<Layout title="fabio.sh" description="Fabio Gschweidl – digital media & IT">
    <!-- 00 // HERO -->
    <Hero t={t} isJa={isJa} />

    <!-- 01 // PROJECTS -->
    <div class="container mx-auto px-4 md:px-12 mt-16 md:mt-24">
        <div class="section-head">
            <span class="idx">01 //</span>
            <h2 class="h-display text-3xl md:text-5xl">{t.menuProjects}</h2>
        </div>
        <ProjectTeaser projects={previewProjects} locale={locale} t={t} plain />
    </div>

    <!-- 02 // CONTACT -->
    <section
        class="container mx-auto px-4 md:px-12 mt-16 md:mt-24 pb-24"
        aria-labelledby="contact-heading"
    >
        <div class="section-head">
            <span class="idx">02 //</span>
            <h2 id="contact-heading" class="h-display text-3xl md:text-5xl">
                {t.contactTitle}
            </h2>
        </div>

        <ContactForm t={t} sent={sent} error={error} />
    </section>
</Layout>
