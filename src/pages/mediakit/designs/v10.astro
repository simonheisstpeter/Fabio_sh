---
import Layout from "../../../layouts/default.astro";
import MosaicWord from "../../../components/MosaicWord.astro";
// v10 variations — three distinct liquid-glass × emerald-mosaic layouts
---

<Layout title="v10 variations – fabio.sh" description="Liquid glass variations">
    <div class="container mx-auto px-6 md:px-12 py-24 space-y-24">

        <!-- V1: liquid hero panel — mosaic inside one big frosted panel -->
        <section id="v1" class="border-2 border-dashed border-ink/15 p-4 md:p-8">
            <p class="font-mono text-xs uppercase tracking-widest mb-6">V1 — Liquid Hero Panel: mosaic inside one frosted slab</p>
            <div class="liquid px-corner p-8 md:p-14 max-w-4xl">
                <div class="meta-row mb-8">
                    <span class="dot bg-accent animate-pulse"></span>
                    <span>Online</span><span class="sep">//</span>
                    <span>Vienna, AT</span><span class="sep">//</span>
                    <span>20:47 CET</span>
                </div>
                <MosaicWord label="FABIO" word="FABIO" />
                <p class="mt-8 text-ink/70 max-w-md">digital media &amp; IT — one liquid slab, mosaic wordmark floating inside, ambient emerald glows refracted through the frost.</p>
                <div class="mt-8 flex gap-4">
                    <a class="btn btn-solid liquid-solid text-sm" href="#">Projects</a>
                    <a class="btn liquid-btn text-sm" href="#">Contact</a>
                </div>
            </div>
        </section>

        <!-- V2: split hero — mosaic left, glass stat card right -->
        <section id="v2" class="border-2 border-dashed border-ink/15 p-4 md:p-8">
            <p class="font-mono text-xs uppercase tracking-widest mb-6">V2 — Split Hero: mosaic left / glass card right</p>
            <div class="grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
                <div>
                    <MosaicWord label="FABIO" word="FABIO" />
                    <div class="mt-8 flex gap-4">
                        <a class="btn btn-solid liquid-solid text-sm" href="#">Projects</a>
                        <a class="btn liquid-btn text-sm" href="#">Contact</a>
                    </div>
                </div>
                <div class="card p-6">
                    <p class="font-pixel text-lg mb-3">Status</p>
                    <p class="text-sm text-ink/60 mb-4">Liquid glass card floating over the dot grid + emerald glows.</p>
                    <p class="font-mono text-xs uppercase tracking-widest text-ink/50">01 // projects · 02 // contact</p>
                </div>
            </div>
            <div class="divider-tiles mt-10" aria-hidden="true"></div>
        </section>

        <!-- V3: full-bleed mosaic wall -->
        <section id="v3" class="border-2 border-dashed border-ink/15 p-4 md:p-8">
            <p class="font-mono text-xs uppercase tracking-widest mb-6">V3 — Mosaic Wall: edge-to-edge wordmark, glass chrome only</p>
            <div class="liquid px-corner p-4 md:p-6 overflow-hidden">
                <div class="v3-word"><MosaicWord label="FABIO" word="FABIO" /></div>
            </div>
            <div class="grid md:grid-cols-3 gap-6 mt-8">
                <div class="card p-5"><p class="font-pixel text-base mb-1">Card A</p><p class="text-xs text-ink/60">liquid glass</p></div>
                <div class="card p-5"><p class="font-pixel text-base mb-1">Card B</p><p class="text-xs text-ink/60">liquid glass</p></div>
                <div class="card p-5"><p class="font-pixel text-base mb-1">Card C</p><p class="text-xs text-ink/60">liquid glass</p></div>
            </div>
        </section>

    </div>
</Layout>

<style>
    /* V3: wordmark scales to fill the panel width */
    .v3-word .mosaic-word-wrap { width: 100%; }
    .v3-word .mosaic-word {
        width: 100%;
        grid-template-columns: repeat(var(--cols), 1fr);
        grid-auto-rows: auto;
        aspect-ratio: var(--cols) / 7;
    }
    .v3-word .mw-tile { width: 100%; height: 100%; aspect-ratio: 1; }
</style>
