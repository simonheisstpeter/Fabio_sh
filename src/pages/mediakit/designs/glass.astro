---
// Overview of the three Liquid Glass × turquoise mosaic options: hero
// thumbnails (public/designs/glass/*.webp) side by side + a comparison. Design preview only
// (English, noindex). Styles are scoped to html[data-design="glass-index"].
import GlassLayout from "../../../components/designs/glass/GlassLayout.astro";

const options = [
    {
        id: "a",
        name: "Aqua Depth",
        mood: "Calm, deep, the most Apple like",
        concept:
            "Dark first: a deep teal ocean. Large rounded tiles drift slowly behind clear glass with bright edges, with two soft caustic lights moving across like light through water.",
        palette: ["#031417", "#0E3A3F", "#177372", "#2FB3A7", "#6FE3D5", "#E9C46A"],
        glass: "blur 24 · saturate 1.7 · brightness 0.5 · teal black fill 16% · radius 32/28",
        mosaic: "15 drifting rounded tiles (24% radius, gloss), 26–48s loops, one sand tile",
        type: "Andes Book only, mixed case, −0.035em tracking; uppercase Book labels",
        best: "A personal site that should feel quietly expensive and native to Apple devices. (Still in the first turquoise palette.)",
        weak: "Least ownable of the three: closest to stock iOS 26. Relies on motion for its character.",
    },
    {
        id: "b",
        name: "Tessellate",
        mood: "Warm, editorial, crafted",
        concept:
            "Light first, in the v8 emerald palette: ivory and mint. A real tessellation with grout lines and diagonal split tiles; milky ivory glass, the hero sits on one large glass plate. Uppercase editorial type with N° indexes.",
        palette: ["#FFFAEB", "#ECE4CF", "#A7F3D0", "#34D399", "#059669", "#047857"],
        glass: "blur 30 · saturate 1.3 · brightness 1.05 · ivory fill 20% · radius 22/20 · grout line",
        mosaic: "20×16 tile grid, 3px grout, split tiles, 2 color currents, breathing tiles",
        type: "Andes Book uppercase display, mono labels and buttons, N° numbering",
        best: "Keeps the most of today's mosaic identity; reads like a design studio or print piece.",
        weak: "The full grid behind every section is busy on long pages. Glass reads as milky rather than clear.",
    },
    {
        id: "c",
        name: "Prism Tile",
        mood: "Bold, dramatic, launch day",
        concept:
            "In the v8 emerald palette: a near black green canvas on a faint tile grid where a few emerald tiles glow and pulse. Darker glass with strong white specular rims and emerald underlight. Black uppercase display.",
        palette: ["#050B09", "#0A1512", "#047857", "#10B981", "#34D399", "#A7F3D0"],
        glass: "blur 40 · saturate 1.8 · brightness 0.42 · fill 4% · radius 26/24 · emerald rim",
        mosaic: "16×13 dark grid, 14 lit tiles with glow, 7–14s opacity pulses",
        type: "Andes Black uppercase display, −0.035em; mono labels; Book body",
        best: "Maximum impact and the strongest product feel; the glow makes the mosaic unmistakable.",
        weak: "Loudest option. Light mode is the weakest light mode of the three; best kept dark only.",
    },
];
---

<GlassLayout title="Liquid Glass options – fabio.sh" design="glass-index">
    <main class="ov">
        <header class="ov-head">
            <p class="ov-kicker">fabio.sh · design preview</p>
            <h1>Liquid Glass × turquoise mosaic</h1>
            <p class="ov-lede">
                Three directions on identical content: nav, hero, project bento, text section, contact
                form, component sheet, footer. B and C now use the v8 emerald palette and each has a
                component options page (every component in three or four variants). Nothing is applied
                to the live site yet.
            </p>
            <button class="ov-theme" type="button" data-ov-theme>Toggle light / dark</button>
        </header>

        <section class="ov-grid" aria-label="Options">
            {
                options.map((o) => (
                    <article class="ov-card">
                        <a class="ov-frame" href={`/mediakit/designs/glass-${o.id}`} aria-label={`Open option ${o.id.toUpperCase()}: ${o.name}`}>
                            <img class="th-dark" src={`/designs/glass/${o.id}-dark.webp`} alt="" width="960" height="573" loading="lazy" decoding="async" />
                            <img class="th-light" src={`/designs/glass/${o.id}-light.webp`} alt="" width="960" height="573" loading="lazy" decoding="async" />
                        </a>
                        <div class="ov-body">
                            <p class="ov-id">Option {o.id.toUpperCase()} · {o.mood}</p>
                            <h2>{o.name}</h2>
                            <p>{o.concept}</p>
                            <ul class="ov-swatches" aria-label="Palette">
                                {o.palette.map((c) => <li style={`--c:${c}`} title={c}><span>{c}</span></li>)}
                            </ul>
                            <span class="ov-links">
                                <a class="ov-open" href={`/mediakit/designs/glass-${o.id}`}>Open full page →</a>
                                {o.id !== "a" && <a class="ov-open" href={`/mediakit/designs/glass-${o.id}-kit`}>Component options →</a>}
                            </span>
                        </div>
                    </article>
                ))
            }
        </section>

        <section class="ov-table-wrap" aria-labelledby="cmp">
            <h2 id="cmp">Comparison</h2>
            <div class="ov-scroll">
                <table>
                    <thead>
                        <tr><th scope="col"></th>{options.map((o) => <th scope="col">{o.id.toUpperCase()} · {o.name}</th>)}</tr>
                    </thead>
                    <tbody>
                        <tr><th scope="row">Glass recipe</th>{options.map((o) => <td>{o.glass}</td>)}</tr>
                        <tr><th scope="row">Mosaic</th>{options.map((o) => <td>{o.mosaic}</td>)}</tr>
                        <tr><th scope="row">Type</th>{options.map((o) => <td>{o.type}</td>)}</tr>
                        <tr><th scope="row">Best for</th>{options.map((o) => <td>{o.best}</td>)}</tr>
                        <tr><th scope="row">Honest weakness</th>{options.map((o) => <td>{o.weak}</td>)}</tr>
                    </tbody>
                </table>
            </div>
            <p class="ov-note">
                All three: AA contrast measured on the rendered glass over the moving mosaic (both themes, 390
                and 1440), opaque fallback without blur support or with reduced transparency, no animation
                under reduced motion, at most two stacked blur layers (nav over one panel).
            </p>
        </section>
    </main>
</GlassLayout>

<style is:global>
    html[data-design="glass-index"] {
        --bg: #f3f5f4;
        --ink: #0d1716;
        --ink-2: #4a5654;
        --line: rgb(13 23 22 / 0.1);
        --card: #ffffff;
    }
    html[data-design="glass-index"][data-theme="dark"] {
        --bg: #0a0f0e;
        --ink: #eef5f3;
        --ink-2: #a3b3af;
        --line: rgb(255 255 255 / 0.1);
        --card: #111817;
    }
    html[data-design="glass-index"] .ov {
        width: min(100% - 32px, 1400px);
        margin: 0 auto;
        padding: 64px 0 96px;
    }
    html[data-design="glass-index"] .ov-kicker,
    html[data-design="glass-index"] .ov-id {
        font: 500 0.72rem/1.4 var(--f-mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-2);
    }
    html[data-design="glass-index"] h1 {
        font-size: clamp(2.2rem, 5vw, 4rem);
        letter-spacing: -0.035em;
        line-height: 1.02;
        font-weight: 400;
        margin: 10px 0 16px;
    }
    html[data-design="glass-index"] .ov-lede {
        max-width: 60ch;
        color: var(--ink-2);
    }
    html[data-design="glass-index"] .ov-theme {
        margin-top: 20px;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--card);
        color: var(--ink);
        font: inherit;
        font-size: 0.9rem;
        cursor: pointer;
    }
    html[data-design="glass-index"] .ov-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: 48px;
    }
    @media (max-width: 1000px) {
        html[data-design="glass-index"] .ov-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    html[data-design="glass-index"] .ov-card {
        display: flex;
        flex-direction: column;
        border-radius: 24px;
        overflow: hidden;
        background: var(--card);
        box-shadow: inset 0 0 0 1px var(--line), 0 30px 60px -40px rgb(0 0 0 / 0.4);
    }
    html[data-design="glass-index"] .ov-frame {
        position: relative;
        display: block;
        aspect-ratio: 960 / 573;
        overflow: hidden;
        background: #000;
    }
    /* static thumbnails (the site's CSP forbids framing), swapped by theme */
    html[data-design="glass-index"] .ov-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 700ms var(--ease-spring);
    }
    html[data-design="glass-index"] .ov-frame:hover img {
        transform: scale(1.02);
    }
    html[data-design="glass-index"]:not([data-theme="dark"]) .th-dark,
    html[data-design="glass-index"][data-theme="dark"] .th-light {
        display: none;
    }
    html[data-design="glass-index"] .ov-body {
        display: grid;
        gap: 12px;
        padding: 22px 22px 26px;
        align-content: start;
    }
    html[data-design="glass-index"] .ov-body h2 {
        font-size: 1.9rem;
        letter-spacing: -0.03em;
        font-weight: 400;
    }
    html[data-design="glass-index"] .ov-body p:not(.ov-id) {
        color: var(--ink-2);
        font-size: 0.95rem;
    }
    html[data-design="glass-index"] .ov-swatches {
        display: flex;
        gap: 6px;
        list-style: none;
        margin: 4px 0 0;
        padding: 0;
    }
    html[data-design="glass-index"] .ov-swatches li {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--c);
        box-shadow: inset 0 0 0 1px var(--line);
    }
    html[data-design="glass-index"] .ov-swatches span {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
    }
    html[data-design="glass-index"] .ov-links {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 22px;
    }
    html[data-design="glass-index"] .ov-open {
        margin-top: 6px;
        width: fit-content;
        text-decoration: none;
        font-size: 0.95rem;
    }
    html[data-design="glass-index"] .ov-open:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    html[data-design="glass-index"] .ov-table-wrap {
        margin-top: 64px;
    }
    html[data-design="glass-index"] .ov-table-wrap h2 {
        font-size: 1.6rem;
        font-weight: 400;
        letter-spacing: -0.02em;
        margin-bottom: 16px;
    }
    html[data-design="glass-index"] .ov-scroll {
        overflow-x: auto;
        border-radius: 18px;
        box-shadow: inset 0 0 0 1px var(--line);
        background: var(--card);
    }
    html[data-design="glass-index"] table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        font-size: 0.92rem;
    }
    html[data-design="glass-index"] th,
    html[data-design="glass-index"] td {
        padding: 14px 18px;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--line);
    }
    html[data-design="glass-index"] tbody th {
        font: 500 0.72rem/1.5 var(--f-mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-2);
        white-space: nowrap;
    }
    html[data-design="glass-index"] td {
        color: var(--ink-2);
    }
    html[data-design="glass-index"] tr:last-child > * {
        border-bottom: 0;
    }
    html[data-design="glass-index"] .ov-note {
        margin-top: 16px;
        max-width: 80ch;
        font-size: 0.85rem;
        color: var(--ink-2);
    }
</style>

<script>
    document.querySelector("[data-ov-theme]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
            localStorage.setItem("theme", next);
        } catch {}
    });
</script>
