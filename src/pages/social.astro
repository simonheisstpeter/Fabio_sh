---
import Layout from "../layouts/default.astro";
import { getTranslations } from "../i18n/index";
import {
    getSocialFeed,
    ATPROTO_DID,
    ATPROTO_PDS,
    BSKY_PROFILE_URL,
} from "../lib/atproto";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

// Read straight from the self-hosted PDS (5-minute in-memory cache).
const feed = await getSocialFeed();

// Joke locales (en-x-cowboy, …) are valid BCP-47 but may not resolve in Intl.
function formatDate(iso: string): string {
    if (!iso) return "";
    try {
        return new Date(iso).toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
        });
    } catch {
        return new Date(iso).toISOString().slice(0, 10);
    }
}
---

<Layout title={`${t.socialTitle} – fabio.sh`} description={t.socialIntro}>
    <div class="container mx-auto py-24 md:py-36 px-4 md:px-12">
        <h1 class="text-5xl font-andesNeueMedium mb-20 animate-fadeIn_2000">
            {t.socialTitle}
        </h1>

        <p
            class="font-andesNeueLight text-base text-white/55 mb-4 max-w-2xl leading-relaxed"
        >
            {t.socialIntro}
        </p>

        <p class="font-andesNeueLight text-sm text-white/40 mb-16 max-w-2xl">
            {t.socialHostedOn}{" "}
            <a
                href={ATPROTO_PDS}
                target="_blank"
                rel="noopener noreferrer"
                class="text-emerald-400 hover:underline">at.fabio.sh</a
            >
            <span class="block mt-1 font-mono text-xs text-white/25 break-all"
                >{ATPROTO_DID}</span
            >
        </p>

        {
            feed ? (
                <section aria-labelledby="feed-heading" class="max-w-2xl">
                    <h2 id="feed-heading" class="sr-only">
                        {t.socialTitle}
                    </h2>

                    <header class="flex items-center gap-4 mb-12">
                        {feed.profile.avatar && (
                            <img
                                src={feed.profile.avatar}
                                alt={feed.profile.displayName}
                                width="64"
                                height="64"
                                loading="lazy"
                                decoding="async"
                                class="h-16 w-16 rounded-full object-cover shrink-0"
                            />
                        )}
                        <div class="flex flex-col gap-0.5">
                            <span class="text-lg font-andesNeueMedium">
                                {feed.profile.displayName}
                            </span>
                            <a
                                href={BSKY_PROFILE_URL}
                                target="_blank"
                                rel="me noopener noreferrer"
                                class="text-sm text-white/60 hover:text-emerald-400 transition-colors duration-200"
                            >
                                @{feed.profile.handle} ↗
                            </a>
                        </div>
                    </header>

                    {feed.posts.length === 0 ? (
                        <p class="text-white/40 font-andesNeueLight">
                            {t.socialEmpty}
                        </p>
                    ) : (
                        <ol class="flex flex-col gap-10">
                            {feed.posts.map((post) => (
                                <li class="border-t border-white/10 pt-6">
                                    <a
                                        href={post.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-xs text-white/40 hover:text-emerald-400 transition-colors duration-200"
                                    >
                                        <time datetime={post.createdAt}>
                                            {formatDate(post.createdAt)}
                                        </time>
                                    </a>

                                    {post.text && (
                                        <p class="mt-3 whitespace-pre-wrap font-andesNeueLight text-white/90 leading-relaxed">
                                            {post.text}
                                        </p>
                                    )}

                                    {post.images.length > 0 && (
                                        <div class="mt-4 grid gap-3 sm:grid-cols-2">
                                            {post.images.map((img) => (
                                                <img
                                                    src={img.url}
                                                    alt={img.alt}
                                                    width={img.aspectRatio?.width}
                                                    height={img.aspectRatio?.height}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="w-full rounded-md border border-white/10"
                                                />
                                            ))}
                                        </div>
                                    )}
                                </li>
                            ))}
                        </ol>
                    )}

                    <a
                        href={BSKY_PROFILE_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-12 inline-block text-sm text-white/60 hover:text-emerald-400 transition-colors duration-200"
                    >
                        {t.socialViewProfile} ↗
                    </a>
                </section>
            ) : (
                <p class="text-white/40 font-andesNeueLight">{t.socialError}</p>
            )
        }
    </div>
</Layout>
