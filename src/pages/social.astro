---
import Layout from "../layouts/default.astro";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";
import { getTranslations } from "../i18n/index";
import {
    getSocialFeed,
    BSKY_PROFILE_URL,
    MU_SOCIAL_PROFILE_URL,
    SIFA_ID_URL,
    CACHE_TTL_MS,
} from "../lib/atproto";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

// Read straight from the self-hosted PDS (stale-while-revalidate memory cache).
const feed = await getSocialFeed();

// Let browsers and any upstream proxy reuse the rendered page. max-age mirrors
// the server-side fresh window; SWR lets a cache serve instantly while it
// revalidates. Nothing here is per-visitor, so `public` is safe.
Astro.response.headers.set(
    "Cache-Control",
    `public, max-age=${CACHE_TTL_MS / 1000}, stale-while-revalidate=1800`,
);

// Joke locales (en-x-cowboy, …) are valid BCP-47 but may not resolve in Intl.
function formatDate(iso: string): string {
    if (!iso) return "";
    try {
        return new Date(iso).toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
        });
    } catch {
        return new Date(iso).toISOString().slice(0, 10);
    }
}
---

<Layout
    title={`ATProto ${t.socialTitle} – fabio.sh`}
    description={t.socialIntro}
>
    <div class="container mx-auto py-24 md:py-36 px-4 md:px-12">
        <div
            class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16 lg:items-start"
        >
        
            <aside class="min-w-0 lg:sticky lg:top-12">
                <h1
                    class="text-4xl font-andesNeueMedium mb-8 animate-fadeIn_2000"
                >
                    <span class="text-emerald-400">ATProto</span>{" "}{
                        t.socialTitle
                    }
                </h1>

                {
                    feed?.profile && (
                        <div class="flex items-center gap-4 mb-8">
                            {feed.profile.avatar && (
                                <picture class="img-frame h-14 w-14 shrink-0 rounded-full">
                                    <img
                                        src={feed.profile.avatar}
                                        alt={feed.profile.displayName}
                                        width="56"
                                        height="56"
                                        loading="eager"
                                        fetchpriority="high"
                                        decoding="async"
                                        class="h-14 w-14 rounded-full object-cover"
                                    />
                                </picture>
                            )}
                            <div class="flex flex-col gap-0.5">
                                <span class="font-andesNeueMedium">
                                    {feed.profile.displayName}
                                    <br />
                                    @{feed.profile.handle}
                                </span>
                                {/* <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-muted1">
                                    <a
                                        href={MU_SOCIAL_PROFILE_URL}
                                        target="_blank"
                                        rel="me noopener noreferrer"
                                        class="hover:text-emerald-400 transition-colors duration-200"
                                    >
                                        mu.social ↗
                                    </a>
                                    <a
                                        href={BSKY_PROFILE_URL}
                                        target="_blank"
                                        rel="me noopener noreferrer"
                                        class="hover:text-emerald-400 transition-colors duration-200"
                                    >
                                        bsky.app ↗
                                    </a>
                                </div> */}
                            </div>
                        </div>
                    )
                }

                <p
                    class="font-andesNeueLight text-base text-muted1 mb-2 leading-relaxed"
                >
                    {t.socialIntro}
                </p>

                <div class="mt-6">
                    <p class="text-sm text-muted1">
                        {t.socialViewProfile}
                    </p>
                    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                        <a
                            href={MU_SOCIAL_PROFILE_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-muted1 hover:text-emerald-400 transition-colors duration-200"
                        >
                            mu.social <ExternalLinkIcon />
                        </a>
                        <a
                            href={BSKY_PROFILE_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-muted1 hover:text-emerald-400 transition-colors duration-200"
                        >
                            bsky <ExternalLinkIcon />
                        </a>
                        <a
                            href={SIFA_ID_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-muted1 hover:text-emerald-400 transition-colors duration-200"
                        >
                            sifa.id <ExternalLinkIcon />
                        </a>

                    </div>
                </div>

                {
                    feed && feed.apps.length > 0 && (
                        <div class="mt-8 border-t border-divider pt-6">
                            <h2 class="text-xs uppercase tracking-widest text-muted3 mb-3">
                                {t.socialAlsoOn}
                            </h2>
                            <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
                                {feed.apps.map((app) => (
                                    <li>
                                        {app.url ? (
                                            <a
                                                href={app.url}
                                                target="_blank"
                                                rel="me noopener noreferrer"
                                                title={app.namespace}
                                                class="inline-flex items-center gap-1 text-muted1 hover:text-emerald-400 transition-colors duration-200"
                                            >
                                                {app.name} <ExternalLinkIcon />
                                            </a>
                                        ) : (
                                            <span
                                                title={app.namespace}
                                                class="text-muted2"
                                            >
                                                {app.name}
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }
            </aside>

            {
                feed ? (
                    <section aria-labelledby="feed-heading" class="min-w-0 max-w-2xl">
                        <h2 id="feed-heading" class="sr-only">
                            {t.socialTitle}
                        </h2>

                        {feed.posts.length === 0 ? (
                            <p class="text-muted2 font-andesNeueLight">
                                {t.socialEmpty}
                            </p>
                        ) : (
                            <ol class="flex flex-col gap-10">
                                {feed.posts.map((post) => (
                                    <li class="border-t border-divider pt-6">
                                        <a
                                            href={post.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-xs text-muted2 hover:text-emerald-400 transition-colors duration-200"
                                        >
                                            <time datetime={post.createdAt}>
                                                {formatDate(post.createdAt)}
                                            </time>
                                        </a>

                                        {post.text && (
                                            <p class="mt-3 whitespace-pre-wrap wrap-break-word font-andesNeueLight text-fg leading-relaxed">
                                                {post.text}
                                            </p>
                                        )}

                                        {post.images.length > 0 && (
                                            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                                                {post.images.map((img) => (
                                                    <span
                                                        class="img-frame block w-full overflow-hidden rounded-md border border-divider"
                                                        style={
                                                            img.aspectRatio
                                                                ? `aspect-ratio:${img.aspectRatio.width}/${img.aspectRatio.height}`
                                                                : undefined
                                                        }
                                                    >
                                                        <img
                                                            src={img.url}
                                                            alt={img.alt}
                                                            width={
                                                                img.aspectRatio
                                                                    ?.width
                                                            }
                                                            height={
                                                                img.aspectRatio
                                                                    ?.height
                                                            }
                                                            loading="lazy"
                                                            decoding="async"
                                                            class="h-full w-full object-cover"
                                                        />
                                                    </span>
                                                ))}
                                            </div>
                                        )}

                                        {post.video && (
                                            <video
                                                controls
                                                preload="none"
                                                aria-label={post.video.alt}
                                                width={post.video.aspectRatio?.width}
                                                height={post.video.aspectRatio?.height}
                                                style={
                                                    post.video.aspectRatio
                                                        ? `aspect-ratio:${post.video.aspectRatio.width}/${post.video.aspectRatio.height}`
                                                        : undefined
                                                }
                                                class="mt-4 w-full max-w-full rounded-md border border-divider"
                                            >
                                                <source src={post.video.url} />
                                            </video>
                                        )}

                                        {post.externalLink && (
                                            <a
                                                href={post.externalLink.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="mt-4 flex overflow-hidden rounded-md border border-divider transition-colors duration-200 hover:border-emerald-400"
                                            >
                                                {post.externalLink.thumbUrl && (
                                                    <img
                                                        src={post.externalLink.thumbUrl}
                                                        alt=""
                                                        loading="lazy"
                                                        decoding="async"
                                                        class="h-24 w-24 shrink-0 object-cover"
                                                    />
                                                )}
                                                <span class="flex min-w-0 flex-col justify-center gap-1 px-4 py-3">
                                                    <span class="truncate text-sm font-andesNeueMedium text-fg">
                                                        {post.externalLink.title || post.externalLink.url}
                                                    </span>
                                                    <span class="truncate text-xs text-muted2">
                                                        {new URL(post.externalLink.url).hostname}
                                                    </span>
                                                </span>
                                            </a>
                                        )}

                                        {post.quotedPostUrl && (
                                            <a
                                                href={post.quotedPostUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="mt-4 inline-flex items-center gap-1 text-xs text-muted2 hover:text-emerald-400 transition-colors duration-200"
                                            >
                                                Quoted post <ExternalLinkIcon />
                                            </a>
                                        )}
                                    </li>
                                ))}
                            </ol>
                        )}
                    </section>
                ) : (
                    <p class="text-muted2 font-andesNeueLight">
                        {t.socialError}
                    </p>
                )
            }
        </div>
    </div>

    <!-- The shimmer is cleared by JS on image load, so without JS the images
         must be shown unconditionally rather than staying at opacity 0. -->
    <noscript>
        <style>
            .img-frame img {
                opacity: 1 !important;
            }
            .img-frame::after {
                content: none !important;
            }
        </style>
    </noscript>
</Layout>

<script>
    // Blobs come off the PDS unresized (a few hundred KB to ~1.8 MB each), so
    // the shimmer is genuinely visible. Swap it out once each image decodes.
    function initImageSkeletons() {
        for (const frame of document.querySelectorAll<HTMLElement>(
            ".img-frame",
        )) {
            const img = frame.querySelector("img");
            if (!img) continue;

            const done = () => frame.classList.add("is-loaded");

            // Cached images may already be complete before this runs.
            if (img.complete && img.naturalWidth > 0) {
                done();
                continue;
            }
            img.addEventListener("load", done, { once: true });
            // On error the alt text shows — don't shimmer forever.
            img.addEventListener("error", done, { once: true });
        }
    }

    // Fires on first load and after every View Transition.
    document.addEventListener("astro:page-load", initImageSkeletons);
</script>

<style>
    /* Alt text styling for images that fail to load. */
    .img-frame img {
        font-style: italic;
        font-size: 10px;
    }

    .img-frame {
        position: relative;
        display: inline-flex;
        background-color: var(--color-surface);
    }

    .img-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: linear-gradient(
            90deg,
            transparent 0%,
            var(--color-raised) 50%,
            transparent 100%
        );
        background-size: 200% 100%;
        animation: social-shimmer 1.4s infinite linear;
        pointer-events: none;
    }

    /* Fade the image in over the shimmer, then drop the shimmer entirely. */
    .img-frame img {
        opacity: 0;
        transition: opacity 0.35s ease;
    }
    .img-frame.is-loaded img {
        opacity: 1;
    }
    .img-frame.is-loaded {
        background-color: transparent;
    }
    .img-frame.is-loaded::after {
        content: none;
    }

    @keyframes social-shimmer {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }

    /* globals.css already neutralises animation under reduced motion; make sure
       the placeholder still disappears rather than sitting there statically. */
    @media (prefers-reduced-motion: reduce) {
        .img-frame::after {
            animation: none;
            background-image: none;
        }
        .img-frame img {
            transition: none;
        }
    }
</style>
