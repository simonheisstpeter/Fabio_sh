---
import Layout from "../layouts/default.astro";
import { getTranslations } from "../i18n/index";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);
---

<Layout title="404 – fabio.sh" description="Page not found">
    <section
        class="h-screen w-full flex flex-col items-center justify-center px-4 relative overflow-hidden"
    >
        <!-- checkerboard block behind the outlined 404 -->
        <div
            class="pixel-checker absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 md:w-96 md:h-96 pointer-events-none select-none"
            aria-hidden="true"
        ></div>
        <h1
            class="text-9xl text-outline mb-6 relative"
            aria-label="Error 404"
        >
            404
        </h1>
        <p class="text-2xl text-fg text-center mb-12">
            {t.custom404Title}
        </p>
        <a
            href={getRelativeLocaleUrl(locale, "/")}
            class="btn"
        >
            {t.custom404Button}
        </a>
    </section>
</Layout>
