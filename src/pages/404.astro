---
import Layout from "../layouts/default.astro";
import { getTranslations } from "../i18n/index";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

// 6x6 mosaic behind the outline 404, cascading in like the hero F
const RAMP = ["#A7F3D0", "#6EE7B7", "#34D399", "#10B981", "#059669", "#047857"];
const bigTiles = Array.from({ length: 36 }, (_, i) => {
    const col = i % 6;
    const row = Math.floor(i / 6);
    return { color: RAMP[(row + col) % 6], delay: 200 + (row + col) * 55 };
});
---

<Layout title="404 – fabio.sh" description="Page not found">
    <section
        class="h-screen w-full flex flex-col items-center justify-center px-4 relative overflow-hidden"
    >
        <span
            class="f-mosaic absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-90"
            style="width:16rem;height:16rem"
            aria-hidden="true"
        >
            {
                bigTiles.map((t) => (
                    <span
                        class="f-tile animate-pop"
                        style={`background:${t.color};animation-delay:${t.delay}ms`}
                    />
                ))
            }
        </span>
        <h1
            class="text-9xl md:text-[15rem] text-outline mb-6 relative"
            aria-label="Error 404"
        >
            404
        </h1>
        <p class="text-2xl text-fg text-center mb-12 relative">
            {t.custom404Title}
        </p>
        <a
            href={getRelativeLocaleUrl(locale, "/")}
            class="btn"
        >
            {t.custom404Button}
        </a>
    </section>
</Layout>
