---
import Layout from "../layouts/default.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import ProjectRow from "../components/projects/ProjectRow.astro";
import CategoryButton from "../components/CategoryButton.astro";

import { getTranslations } from "../i18n/index";
import { getAllProjects } from "../lib/db";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

const allProjects = getAllProjects();
const currentProjects = allProjects.filter((p) => p.published && !p.finished);
const upcomingProjects = allProjects.filter((p) => !p.published && !p.finished);
const finishedProjects = allProjects.filter((p) => p.finished);

const allCategories = [
    ...new Set(allProjects.flatMap((p) => p.categories)),
].sort();

const firstCategories = allCategories.filter((cat, index) => index < 4);
const otherCategories = allCategories.filter((cat, index) => index >= 4);
---

<Layout
    title={`${t.menuProjects} – fabio.sh`}
    description="All projects by Fabio Gschweidl – web development, design and conception"
>
    <div class="container mx-auto h-full px-4 md:px-12 pb-12">
        <h1 class="my-20 text-5xl font-andesNeueMedium animate-fadeIn_2000">
            {t.menuProjects}
        </h1>

        <!-- Search + category filters + sort -->
        <div class="mb-12 flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-4">
                <input
                    id="project-search"
                    type="search"
                    placeholder={t.searchPlaceholder}
                    class="w-full max-w-md rounded-lg bg-surface border border-edge px-4 py-2 text-sm text-fg placeholder-muted3 focus:outline-none focus:border-emerald-400 transition-colors"
                />

                <div class="flex items-center gap-2 text-xs">
                    <span class="text-muted3">{t.sortLabel}</span>
                    <button
                        data-sort="recent"
                        class="sort-btn border border-emerald-400 text-emerald-400 px-3 py-1 rounded-full transition-colors"
                    >
                        {t.sortRecent}
                    </button>
                    <button
                        data-sort="alpha"
                        class="sort-btn border border-divider text-muted2 hover:border-edge hover:text-fg px-3 py-1 rounded-full transition-colors"
                    >
                        {t.sortAlpha}
                    </button>
                </div>
            </div>

            <div class="grid gap-2">
                <ul class="flex flex-wrap gap-2 row-gap-3">
                    <li>
                        <button
                            data-category=""
                            class="filter-btn w-fit border border-emerald-400 text-emerald-400 px-3 py-1 rounded-full text-xs transition-colors"
                        >
                            {t.filterAll}
                        </button>
                    </li>

                    {firstCategories.map((cat) => <CategoryButton cat={cat} />)}
                    <li>...</li>
                </ul>

                <details class="flex flex-wrap gap-2">
                    <summary>{t.filterMore}</summary>
                    <ul class="flex flex-wrap gap-2">
                        {
                            otherCategories.map((cat) => (
                                <CategoryButton cat={cat} />
                            ))
                        }
                    </ul>
                </details>
            </div>
        </div>

        <!-- Current -->
        <section data-section aria-labelledby="current-heading" class="mb-20">
            <h2
                id="current-heading"
                class="mb-6 text-lg font-andesNeueMedium text-emerald-400"
            >
                {t.currentProjects}
            </h2>
            <ul
                data-sortable
                class="grid grid-cols-1 gap-8 lg:grid-cols-2"
            >
                {
                    currentProjects.map((project) => (
                        <ProjectCard project={project} locale={locale} t={t} />
                    ))
                }
            </ul>
        </section>

        <!-- Upcoming / Paused -->
        <section data-section aria-labelledby="upcoming-heading" class="mb-20">
            <h2 id="upcoming-heading" class="mb-6 text-lg font-andesNeueMedium">
                {t.upcomingProjects}
            </h2>
            <ol data-sortable class="flex flex-col">
                {
                    upcomingProjects.map((project) => (
                        <ProjectRow project={project} locale={locale} t={t} />
                    ))
                }
            </ol>
        </section>

        <!-- Finished -->
        <section data-section aria-labelledby="finished-heading" class="mb-20">
            <h2 id="finished-heading" class="mb-6 text-lg font-andesNeueMedium">
                {t.finishedProjects}
            </h2>
            <ol data-sortable class="flex flex-col">
                {
                    finishedProjects.map((project) => (
                        <ProjectRow project={project} locale={locale} t={t} />
                    ))
                }
            </ol>
        </section>
    </div>

    <script>
        const searchInput = document.getElementById(
            "project-search",
        ) as HTMLInputElement | null;
        const filterBtns =
            document.querySelectorAll<HTMLButtonElement>(".filter-btn");
        const sortBtns =
            document.querySelectorAll<HTMLButtonElement>(".sort-btn");
        const items = document.querySelectorAll<HTMLElement>(".project-item");
        const sortables =
            document.querySelectorAll<HTMLElement>("[data-sortable]");
        const sections =
            document.querySelectorAll<HTMLElement>("[data-section]");

        let activeCategory = "";
        let searchTerm = "";
        let activeSort: "recent" | "alpha" = "recent";

        function applyFilters() {
            items.forEach((item) => {
                const categories: string[] = JSON.parse(
                    item.dataset.categories ?? "[]",
                );
                const title = item.dataset.title ?? "";
                const description = item.dataset.description ?? "";
                const matchesCategory =
                    !activeCategory || categories.includes(activeCategory);
                const matchesSearch =
                    !searchTerm ||
                    title.includes(searchTerm) ||
                    description.includes(searchTerm) ||
                    categories.some((c) =>
                        c.toLowerCase().includes(searchTerm),
                    );
                item.classList.toggle(
                    "hidden",
                    !(matchesCategory && matchesSearch),
                );
            });

            sections.forEach((section) => {
                const hasVisible =
                    section.querySelectorAll(".project-item:not(.hidden)")
                        .length > 0;
                section.classList.toggle("hidden", !hasVisible);
            });
        }

        function applySort() {
            sortables.forEach((container) => {
                const children = Array.from(
                    container.querySelectorAll<HTMLElement>(":scope > .project-item"),
                );
                children.sort((a, b) => {
                    if (activeSort === "alpha") {
                        return (a.dataset.title ?? "").localeCompare(
                            b.dataset.title ?? "",
                        );
                    }
                    return (
                        (b.dataset.created ?? "").localeCompare(
                            a.dataset.created ?? "",
                        ) || (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "")
                    );
                });
                for (const child of children) container.appendChild(child);
            });
        }

        searchInput?.addEventListener("input", (e) => {
            searchTerm = (e.target as HTMLInputElement).value
                .toLowerCase()
                .trim();
            applyFilters();
        });

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeCategory = btn.dataset.category ?? "";
                filterBtns.forEach((b) => {
                    const isActive = b === btn;
                    b.classList.toggle("border-emerald-400", isActive);
                    b.classList.toggle("text-emerald-400", isActive);
                    b.classList.toggle("border-divider", !isActive);
                    b.classList.toggle("text-muted2", !isActive);
                });
                applyFilters();
            });
        });

        sortBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeSort = (btn.dataset.sort ?? "recent") as
                    | "recent"
                    | "alpha";
                sortBtns.forEach((b) => {
                    const isActive = b === btn;
                    b.classList.toggle("border-emerald-400", isActive);
                    b.classList.toggle("text-emerald-400", isActive);
                    b.classList.toggle("border-divider", !isActive);
                    b.classList.toggle("text-muted2", !isActive);
                });
                applySort();
            });
        });

        // Server-rendered order is DB order, not "recent" — sort once up front
        // so the initially-active "recent" button matches what's on screen.
        applySort();
    </script>

    <script>
        let partyLoaded = false;
        const observer = new IntersectionObserver(() => {
            if (!partyLoaded) {
                partyLoaded = true;
                import("https://cdn.jsdelivr.net/npm/party-js@2.2.0/bundle/party.min.js").catch(
                    () => {},
                );
            }
        });
        const footer = document.querySelector("footer");
        if (footer) observer.observe(footer);
    </script>
</Layout>
