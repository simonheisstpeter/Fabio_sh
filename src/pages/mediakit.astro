---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/default.astro';
import Loader from '../components/Loader.astro';
import MosaicHead from '../components/MosaicHead.astro';
import { getTranslations } from '../i18n/index';

const locale = Astro.currentLocale ?? 'de';
const t = getTranslations(locale);

// Live design experiments (English-only preview pages under /mediakit/designs)
const designsUrl = getRelativeLocaleUrl(locale, '/mediakit/designs/cards');

// Keep in sync with the palette tokens in src/styles/globals.css.
const colors = [
  { name: 'Ink',     hex: '#1f1f1f', class: 'bg-ink border-2 border-edge' },
  { name: 'Paper',   hex: '#fffaeb', class: 'bg-paper border-2 border-edge' },
  { name: 'Accent',  hex: '#047857', class: 'bg-accent border-2 border-edge' },
  { name: 'Emerald-500', hex: '#10b981', class: 'border-2 border-edge', style: 'background:#10b981' },
  { name: 'Surface', hex: '#e9f7f0', class: 'bg-surface border-2 border-edge' },
  { name: 'Muted',   hex: '#5c7268', class: 'bg-ink-soft border-2 border-edge' },
  { name: 'Block',   hex: 'var(--grad-block)', class: 'border-2 border-edge', style: 'background:linear-gradient(90deg,#a7f3d0,#6ee7b7,#34d399,#10b981,#059669,#047857)' },
];
// Dark theme tokens — keep in sync with [data-theme="dark"] in globals.css
const colorsDark = [
  { name: 'Paper',   hex: '#0a1512', class: 'border-2 border-edge', style: 'background:#0a1512' },
  { name: 'Ink',     hex: '#e6fbf2', class: 'border-2 border-edge', style: 'background:#e6fbf2' },
  { name: 'Accent',  hex: '#34d399', class: 'border-2 border-edge', style: 'background:#34d399' },
  { name: 'Surface', hex: '#12211c', class: 'border-2 border-edge', style: 'background:#12211c' },
  { name: 'Divider', hex: '#234237', class: 'border-2 border-edge', style: 'background:#234237' },
];
---

<Layout
  title={`${t.mediakitTitle} – fabio.sh`}
  description="Brand guidelines and media kit for fabio.sh"
>
  <div class="container mx-auto pt-24 md:pt-32 font-andesNeueLight px-6 md:px-12 pb-24">
    <MosaicHead />
    <h1 class="h-display page-title text-3xl md:text-5xl mb-12 text-fg animate-fadeIn_2000">
      {t.mediakitTitle}
    </h1>

    <!-- Fonts -->
    <section aria-labelledby="section-fonts" class="mb-16">
      <h2
        id="section-fonts"
        class="border-b border-ink pb-1 text-fg hover:text-ink duration-200 inline-block mb-10"
      >
        {t.mediakitFonts}
      </h2>
      <div class="md:w-2/3 text-fg space-y-6">
        <div>
          <p class="font-book text-4xl mb-3">Andes Neue Book</p>
          <button
            class="copy-btn chip text-left normal-case"
            data-copy="font-family: 'AndesNeueBook', sans-serif; font-weight: 400; (display + body)"
          >font-family: 'AndesNeueBook', sans-serif; font-weight: 400; (display + body)</button>
        </div>
        <div>
          <p class="font-black text-4xl mb-3 uppercase">Andes Neue Black</p>
          <button
            class="copy-btn chip text-left normal-case"
            data-copy="font-family: 'AndesNeueBlack', sans-serif; font-weight: 900; (hero only)"
          >font-family: 'AndesNeueBlack', sans-serif; font-weight: 900; (hero only)</button>
        </div>
        <div>
          <p class="font-andesNeueMedium text-3xl mb-3">Andes Neue Medium</p>
          <button
            class="copy-btn chip text-left normal-case"
            data-copy="font-family: 'AndesNeueMedium', sans-serif; font-weight: 500;"
          >font-family: 'AndesNeueMedium', sans-serif; font-weight: 500;</button>
        </div>
        <div>
          <p class="font-andesNeueLight text-3xl mb-3">Andes Neue Light</p>
          <button
            class="copy-btn chip text-left normal-case"
            data-copy="font-family: 'AndesNeueLight', sans-serif; font-weight: 300;"
          >font-family: 'AndesNeueLight', sans-serif; font-weight: 300;</button>
        </div>
      </div>
    </section>

    <!-- Colors -->
    <section aria-labelledby="section-colors" class="mb-16">
      <h2
        id="section-colors"
        class="border-b border-ink pb-1 text-fg hover:text-ink duration-200 inline-block mb-10"
      >
        {t.mediakitColors}
      </h2>
      <ul class="list-none md:w-2/3 grid grid-cols-2 md:grid-cols-4 gap-8 text-fg">
        {colors.map(({ name, hex, class: cls }) => (
          <li>
            <button
              class="copy-btn text-center bg-transparent border-0 cursor-pointer group p-0"
              data-copy={hex}
            >
              <div class={`h-20 w-20 mx-auto ${cls} mb-4 transition-transform duration-200 group-hover:scale-105`}></div>
              <span class="block text-sm">{name}</span>
              <span class="block text-xs text-ink font-mono mt-1">{hex}</span>
            </button>
          </li>
        ))}
      </ul>

      <h3 class="h-display text-sm uppercase tracking-widest text-muted2 mt-10 mb-4">Dark theme</h3>
      <ul class="list-none md:w-2/3 grid grid-cols-2 md:grid-cols-4 gap-8 text-fg">
        {colorsDark.map(({ name, hex, class: cls, style }) => (
          <li>
            <button
              class="copy-btn text-center bg-transparent border-0 cursor-pointer group p-0"
              data-copy={hex}
            >
              <div class={`h-20 w-20 mx-auto ${cls} mb-4 transition-transform duration-200 group-hover:scale-105`} style={style}></div>
              <span class="block text-sm">{name}</span>
              <span class="block text-xs text-ink font-mono mt-1">{hex}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    <!-- Cursor -->
    <section aria-labelledby="section-cursor" class="mb-16">
      <h2
        id="section-cursor"
        class="border-b border-ink pb-1 text-fg hover:text-ink duration-200 inline-block mb-10"
      >
        {t.mediakitCursor}
      </h2>
      <div class="md:w-2/3">
        <img src="/f.png" height="30" width="30" alt="Custom F cursor – fabio.sh" loading="lazy" />
      </div>
    </section>

    <!-- Loader -->
    <section aria-labelledby="section-loader" class="mb-16">
      <h2
        id="section-loader"
        class="border-b border-ink pb-1 text-fg hover:text-ink duration-200 inline-block mb-10"
      >
        {t.mediakitLoader}
      </h2>
      <div class="md:w-2/3 flex justify-center">
        <Loader big />
      </div>
    </section>

    <!-- Design experiments: live preview pages (English only) -->
    <section aria-labelledby="section-designs" class="mb-16">
      <h2
        id="section-designs"
        class="border-b border-ink pb-1 text-fg hover:text-ink duration-200 inline-block mb-10 font-mono text-sm uppercase tracking-widest"
      >
        // designs
      </h2>
      <div class="md:w-2/3">
        <p class="text-fg text-sm mb-4">
          Live design experiments and component previews. Currently: card design options
          (English only).
        </p>
        <a
          href={designsUrl}
          class="inline-flex items-center gap-2 border-2 border-ink px-4 py-2 text-sm text-ink hover:bg-ink hover:text-paper transition-colors duration-200"
        >
          /mediakit/designs/cards
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </section>

  </div>
</Layout>

<script>
  function showTooltip(anchor: HTMLElement) {
    const existing = anchor.querySelector<HTMLElement>('.copy-tooltip');
    if (existing) return;
    const tip = document.createElement('span');
    tip.className = 'copy-tooltip';
    tip.textContent = 'Copied!';
    tip.style.cssText =
      'position:absolute;left:50%;transform:translateX(-50%);bottom:calc(100% + 6px);' +
      'background:var(--ink);color:var(--paper);font-family:var(--font-mono);font-size:0.65rem;letter-spacing:0.08em;white-space:nowrap;' +
      'padding:4px 8px;border-radius:0;pointer-events:none;z-index:50;';
    anchor.style.position = 'relative';
    anchor.appendChild(tip);
    setTimeout(() => tip.remove(), 1500);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (btn.dataset.copyInit) return;
      btn.dataset.copyInit = '1';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? btn.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          showTooltip(btn);
        } catch {
          // clipboard API unavailable (non-HTTPS or denied)
        }
      });
    });
  });
</script>
