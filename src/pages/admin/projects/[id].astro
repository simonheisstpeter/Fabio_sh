---
import AdminLayout from '../../../components/AdminLayout.astro';
import ProjectForm from '../../../components/ProjectForm.astro';
import { getProject } from '../../../lib/db';

const project = getProject(Astro.params.id!);
if (!project) return Astro.redirect('/admin/projects');
---

<AdminLayout title={`Edit: ${project.title}`}>
  <div class="flex items-center gap-3 mb-6">
    <h1 class="text-2xl font-semibold text-gray-50 mb-0">Edit Project</h1>
    <code class="text-xs text-gray-500 bg-[#1a1a1a] px-2 py-0.5 rounded">{project.id}</code>
  </div>
  <ProjectForm project={project} />
</AdminLayout>
