---
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTranslations, LOCALES, LOCALE_LABELS } from "../i18n/index";
import BetaRibbon from "../components/BetaRibbon.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import SkipLink from "../components/SkipLink.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import "../styles/globals.css";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "fabio.sh",
    description = "Fabio Gschweidl – digital media & IT",
    ogImage = "/meta_pic.png",
}: Props = Astro.props;

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

// Build language switcher URLs
const currentPath = Astro.url.pathname;
const localePrefixRe = new RegExp(`^\\/(${LOCALES.join("|")})(\\/$|$|\\/)`);

function getPathForLocale(targetLocale: string) {
    return (
        getRelativeLocaleUrl(targetLocale, "/").replace(/\/$/, "") +
        (currentPath === "/" ? "/" : currentPath.replace(localePrefixRe, "/"))
    );
}

const isHome =
    currentPath === "/" ||
    LOCALES.some((l) => currentPath === `/${l}` || currentPath === `/${l}/`);

const siteUrl = "https://fabio.sh";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const NavLinks = [
    {
        href: getRelativeLocaleUrl(locale, "/"),
        text: t.menuHome,
        mobileOnly: true,
    },
    {
        href: getRelativeLocaleUrl(locale, "/projects"),
        text: t.menuProjects,
    },
    {
        href: getRelativeLocaleUrl(locale, "/about"),
        text: t.menuAbout,
    },
    {
        href: getRelativeLocaleUrl(locale, "/social"),
        text: t.menuSocial,
    },
    {
        href: getRelativeLocaleUrl(locale, "/contact"),
        text: t.menuContact,
    },
];
---

<!doctype html>
<html lang={locale} class="dotsDark scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Favicons -->
        <link rel="icon" href="/carp-streamer.ico" />
         <!--  <link
            rel="apple-touch-icon"
            href="/apple-touch-icon.png"
            sizes="180x180"
        /> -->

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={`${siteUrl}${ogImage}`} />
        <meta property="og:site_name" content="fabio.sh" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

        <!-- Font preloads -->
        <link
            rel="preload"
            href="/fonts/AndesNeue-Medium.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            href="/fonts/AndesNeue-Light.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />

        <!-- Hreflang for SEO -->
        {
            LOCALES.map((l) => (
                <link
                    rel="alternate"
                    hreflang={l}
                    href={`${siteUrl}${getRelativeLocaleUrl(l, "/")}`}
                />
            ))
        }

        <ClientRouter />

        <!-- Umami analytics -->
        <script
            is:inline
            defer
            src="https://analytics.diedigitale.at/script.js"
            data-website-id="4f1d5a2c-5469-40c9-9eed-a54468d434c5"
            data-do-not-track="true"></script>
    </head>

    <body
        class="cursor-fabiosh min-h-screen bg-canvas text-fg font-andesNeueLight relative"
    >
        <SkipLink />
        <a href="#" id="top" class="sr-only" tabindex="-1" aria-hidden="true"
            >top</a
        >

        <!-- Mobile nav -->
        <nav
            class="fixed top-0 z-20 w-full bg-canvas/95 backdrop-blur-sm md:hidden"
            aria-label={t.menuHome}
        >
            <details id="mobile-menu" class="group">
                <summary
                    class="flex items-center justify-end px-6 py-4 list-none cursor-pointer select-none"
                    aria-label="Toggle Menu"
                    aria-controls="mobile-menu-panel"
                    aria-expanded="false"
                >
                    <!-- Hamburger icon (visible when closed) -->
                    <svg
                        class="h-7 w-7 group-open:hidden"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <!-- Close icon (visible when open) -->
                    <svg
                        class="h-7 w-7 hidden group-open:block"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                </summary>

                <div class="dotsDark h-screen pt-24 pl-8 text-left">
                    <nav
                        id="mobile-menu-panel"
                        class="grid grid-cols-1 text-3xl gap-6 font-andesNeueMedium"
                    >
                        <div>
                            <ul class="flex flex-col gap-4">
                                {
                                    NavLinks.map((a) => (
                                        <li>
                                            <a
                                                href={a.href}
                                                class="py-4 hover:text-emerald-400 transition duration-200"
                                            >
                                                {a.text}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>

                            <select
                                id="lang-select-mobile"
                                aria-label={t.languageSelect}
                                class="mt-4 bg-transparent text-fg text-lg tracking-wide border border-edge rounded-md px-3 py-1"
                            >
                                {
                                    LOCALES.map((l) => (
                                        <option
                                            value={getPathForLocale(l)}
                                            selected={l === locale}
                                        >
                                            {LOCALE_LABELS[l]}
                                        </option>
                                    ))
                                }
                            </select>
                        </div>
                    </nav>
                </div>
            </details>
        </nav>

        <div id="page-content">
            <!-- <BetaRibbon /> -->

            <!-- Desktop nav -->
            <header class="hidden md:block">
                <nav
                    class="flex items-start justify-between pr-10 pt-10"
                    aria-label="Main navigation"
                >
                    <a
                        href={getRelativeLocaleUrl(locale, "/")}
                        aria-current={isHome ? "page" : undefined}
                        aria-label={t.menuHome}
                        class="ml-6"
                    >
                        <Loader />
                    </a>

                    <ul
                        class="flex items-center gap-6 font-andesNeueLight text-sm tracking-wide"
                    >
                        {
                            NavLinks.filter((link) => !link.mobileOnly).map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        aria-current={
                                            Astro.url.pathname === link.href
                                                ? "page"
                                                : undefined
                                        }
                                        class="transition-colors duration-200 hover:text-emerald-400 aria-[current=page]:text-emerald-400"
                                    >
                                        {link.text}
                                    </a>
                                </li>
                            ))
                        }
                        <li>
                            <select
                                id="lang-select"
                                aria-label={t.languageSelect}
                                class="bg-transparent text-fg tracking-wide border-none cursor-pointer hover:text-emerald-400 transition duration-200"
                            >
                                {
                                    LOCALES.map((l) => (
                                        <option
                                            value={getPathForLocale(l)}
                                            selected={l === locale}
                                        >
                                            {LOCALE_LABELS[l]}
                                        </option>
                                    ))
                                }
                            </select>
                        </li>
                    </ul>
                </nav>
            </header>

            <main id="main-content" class="font-andesNeueLight">
                <slot />
            </main>

            <ScrollToTop label={t.scrollTop} />
            <Footer locale={locale} t={t} />
        </div>

        <!-- Language switcher script (progressive: enhances <select> navigation) -->
        <script>
            import consoleMessage from "../lib/fun/console-message";
            import titleAnimation from "../lib/fun/title-animation";

            function initLangSelect(id: string) {
                const sel = document.getElementById(
                    id,
                ) as HTMLSelectElement | null;
                if (!sel || sel.dataset.lsInit) return;
                sel.dataset.lsInit = "1";
                sel.addEventListener("change", () => {
                    if (sel.value) window.location.href = sel.value;
                });
            }

            function initMobileLangSelect(id: string) {
                const sel = document.getElementById(
                    id,
                ) as HTMLSelectElement | null;
                if (!sel) return;
                // Prevent click/touch from bubbling to <details> and toggling it closed
                sel.addEventListener("click", (e) => e.stopPropagation());
                sel.addEventListener("touchend", (e) => e.stopPropagation());
                initLangSelect(id);
            }

            // Traps focus inside the open mobile menu: the rest of the page is
            // made `inert` while it's open (so Tab simply can't reach it), and
            // Tab/Shift+Tab wrap between the toggle button and the panel's last
            // focusable item so keyboard users can't tab out of an open menu.
            function initMobileMenuTrap() {
                const details = document.getElementById(
                    "mobile-menu",
                ) as HTMLDetailsElement | null;
                const summary = details?.querySelector("summary");
                const panel = document.getElementById("mobile-menu-panel");
                const pageContent = document.getElementById("page-content");
                if (!details || !summary || !panel || details.dataset.trapInit)
                    return;
                details.dataset.trapInit = "1";

                function focusable(): HTMLElement[] {
                    return [
                        summary!,
                        ...panel!.querySelectorAll<HTMLElement>("a[href], select"),
                    ];
                }

                details.addEventListener("toggle", () => {
                    summary!.setAttribute(
                        "aria-expanded",
                        String(details!.open),
                    );

                    if (details!.open) {
                        pageContent?.setAttribute("inert", "");
                        focusable()[1]?.focus();
                    } else {
                        pageContent?.removeAttribute("inert");
                    }
                });

                details.addEventListener("keydown", (e) => {
                    if (!details!.open) return;

                    if (e.key === "Escape") {
                        e.preventDefault();
                        details!.open = false;
                        summary!.focus();
                        return;
                    }

                    if (e.key !== "Tab") return;

                    const items = focusable();
                    const first = items[0];
                    const last = items[items.length - 1];

                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                });
            }

            // astro:page-load fires on both initial load and after every View Transition
            document.addEventListener("astro:page-load", () => {
                initLangSelect("lang-select");
                initMobileLangSelect("lang-select-mobile");
                initMobileMenuTrap();
            });

            consoleMessage();
            titleAnimation();
        </script>
    </body>
</html>
