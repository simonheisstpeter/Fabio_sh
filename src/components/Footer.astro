---
import type { Translations } from "../i18n/index";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
    locale: string;
    t: Translations;
}

const { locale, t }: Props = Astro.props;
const email = "fabio@fabio.sh";

const footerLinks = [
    {
        title: "Mediakit",
        href: getRelativeLocaleUrl(locale, "/mediakit"),
    },
    {
        title: "llms.txt",
        href: "/llms.txt",
    },
    {
        title: "CV",
        href: getRelativeLocaleUrl(locale, "/cv"),
    },
    {
        title: "Courses",
        href: "/courses"
    },
];
---

<footer
    class="container mx-auto select-none font-andesNeueLight my-20 flex justify-between px-4 md:px-12"
>
    <div>
        <p class="text-sm text-muted1" data-obfuscation="0">
            {t.contactEMail}
        </p>
        <a
            href={`mailto:${email}`}
            data-obfuscation="0"
            class="transition-colors hover:text-emerald-400 text-fg duration-200"
        >
            {email}
        </a>

        <a
            href={getRelativeLocaleUrl(locale, "/social")}
            class="mt-3 flex items-center gap-1.5 text-sm text-muted1 transition-colors duration-200 hover:text-emerald-400"
        >
            <svg
                viewBox="0 0 568 501"
                fill="currentColor"
                class="h-3.5 w-3.5"
                aria-hidden="true"
            >
                <path
                    d="M123.121 33.6637C188.241 82.5526 258.281 181.681 284 234.873C309.719 181.681 379.759 82.5526 444.879 33.6637C491.866 -1.61183 568 -28.9064 568 57.9464C568 75.2916 558.055 203.659 552.222 224.501C531.947 296.954 458.067 315.434 392.347 304.249C507.222 323.8 536.444 388.56 473.333 453.32C353.473 576.312 301.061 422.461 287.631 383.039C285.169 375.812 284.017 372.431 284 375.306C283.983 372.431 282.831 375.812 280.369 383.039C266.939 422.461 214.527 576.312 94.6667 453.32C31.5556 388.56 60.7778 323.8 175.653 304.249C109.933 315.434 36.0535 296.954 15.7778 224.501C9.94525 203.659 0 75.2916 0 57.9464C0 -28.9064 76.1345 -1.61183 123.121 33.6637Z"
                ></path>
            </svg>
            Bluesky
        </a>
    </div>

    <ul class="flex flex-col gap-2 text-sm text-right">
        {
            footerLinks.map(({ title, href }) => (
                <li>
                    <a
                        href={href}
                        class="transition-colors duration-200 text-muted1 hover:text-emerald-400"
                    >
                        {title}
                    </a>
                </li>
            ))
        }
    </ul>
    
    <a
        href="https://www.thegreenwebfoundation.org/green-web-check/?url=https%3A%2F%2Ffabio.sh"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0"
    >
        <img
            src="/fabio_sh_gwf_check.png"
            alt="This website runs on green hosting - verified by thegreenwebfoundation.org"
            width="100"
            height="47"
        />
    </a>
</footer>
