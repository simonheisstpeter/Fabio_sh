---
// Big mosaic wordmark: "FABIO" rendered as a tile grid (5x7 pixel font per
// letter), each filled tile colored by diagonal step of the block ramp —
// same language as the 18px MiniMosaic, scaled up. Tiles pop in staggered.
interface Props {
    word?: string;
    label: string;
}

const { word = "FABIO", label }: Props = Astro.props;

const RAMP = ["#A7F3D0", "#6EE7B7", "#34D399", "#10B981", "#059669", "#047857"];

// 5x7 pixel font
const FONT: Record<string, string[]> = {
    F: ["11111", "10000", "10000", "11110", "10000", "10000", "10000"],
    A: ["01110", "10001", "10001", "11111", "10001", "10001", "10001"],
    B: ["11110", "10001", "10001", "11110", "10001", "10001", "11110"],
    I: ["11111", "00100", "00100", "00100", "00100", "00100", "11111"],
    O: ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
};

const letters = word.toUpperCase().split("");
const cols = letters.length * 5 + (letters.length - 1); // 5 per letter + 1 gap
const cells: { color: string | null; delay: number }[] = [];
letters.forEach((ch, li) => {
    const glyph = FONT[ch] ?? FONT["I"];
    for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 5; c++) {
            if (glyph[r][c] === "1") {
                const col = li * 6 + c;
                cells.push({
                    color: RAMP[(r + col) % 6],
                    delay: 150 + (r + col) * 45,
                });
            } else {
                cells.push({ color: null, delay: 0 });
            }
        }
    }
});
---

<h1 class="sr-only">{label}</h1>
<span
    class="mosaic-word px-corner"
    style={`--cols:${cols}`}
    role="img"
    aria-label={label}
>
    {
        cells.map((cell) =>
            cell.color ? (
                <span
                    class="mw-tile animate-pop"
                    style={`background:${cell.color};animation-delay:${cell.delay}ms`}
                />
            ) : (
                <span class="mw-tile mw-empty" />
            ),
        )
    }
    <span class="mw-tile mw-caret animate-blink" aria-hidden="true" />
</span>
