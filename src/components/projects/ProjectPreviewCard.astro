---
interface Props {
    title: string;
    index: number;
}

const { title, index }: Props = Astro.props;
// Format index to 01, 02, etc.
const displayIndex = String(index + 1).padStart(2, "0");
---

<li class="list-none">
    <article
        class="card card-hover group relative overflow-hidden p-8 animate-fadeIn_2200"
        data-delay={String(index * 150)}
    >
        <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
                <span
                    class="block font-black text-6xl leading-none text-outline mb-3 select-none"
                    aria-hidden="true"
                >
                    {displayIndex}
                </span>
                <span
                    class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent"
                >
                    // preview
                </span>
                <h3
                    class="mt-2 text-xl md:text-2xl font-display text-fg group-hover:text-ink transition-colors leading-tight"
                >
                    {title}
                </h3>
            </div>

            <div
                class="mt-12 flex items-center text-[10px] font-andesNeueMedium text-ink-soft uppercase tracking-[0.2em]"
            >
                <span class="w-6 h-px bg-ink-30 mr-3"></span>
                Active Status
            </div>
        </div>
    </article>
</li>

<script>
document.querySelectorAll<HTMLElement>('[data-delay]').forEach((el) => {
  el.style.animationDelay = el.dataset.delay + 'ms';
});
</script>
