---
interface Props {
    title: string;
    index: number;
}

const { title, index }: Props = Astro.props;
// Format index to 01, 02, etc.
const displayIndex = String(index + 1).padStart(2, "0");
---

<li class="list-none">
    <article
        class="group relative overflow-hidden rounded-2xl bg-surface border border-divider p-8 transition-all duration-500 hover:-translate-y-2 hover:bg-raised hover:border-ink-30 animate-fadeIn_2200"
        data-delay={String(index * 150)}
    >
        <!-- Decorative Background Glow -->
        <div
            class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-ink-05 blur-3xl group-hover:bg-ink-15 transition-all duration-500"
        >
        </div>

        <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
                <span
                    class="text-ink font-mono text-xs mb-4 block opacity-70 tracking-tighter"
                >
                    {displayIndex} // PREVIEW
                </span>
                <h3
                    class="text-xl md:text-2xl font-pixel text-fg group-hover:text-ink transition-colors leading-tight"
                >
                    {title}
                </h3>
            </div>

            <div
                class="mt-12 flex items-center text-[10px] font-andesNeueMedium text-ink-soft uppercase tracking-[0.2em]"
            >
                <span class="w-6 h-px bg-ink-30 mr-3"></span>
                Active Status
            </div>
        </div>
    </article>
</li>

<script>
document.querySelectorAll<HTMLElement>('[data-delay]').forEach((el) => {
  el.style.animationDelay = el.dataset.delay + 'ms';
});
</script>
