---
interface Props {
    title: string;
    index: number;
    big?: boolean;
}

const { title, index, big = false }: Props = Astro.props;
// Format index to 01, 02, etc.
const displayIndex = String(index + 1).padStart(2, "0");
---

<li class={`list-none ${big ? "bento-big" : ""}`}>
    <article
        class={`card card-hover preview-card group relative overflow-hidden p-8 h-full animate-fadeIn_2200 ${big ? "md:p-10" : ""}`}
        data-delay={String(index * 150)}
    >
        <span class="mini-mosaic preview-tick" aria-hidden="true"></span>
        <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
                <span
                    class={`preview-num block font-display leading-none text-outline mb-3 select-none ${big ? "text-8xl" : "text-6xl"}`}
                    aria-hidden="true"
                >
                    {displayIndex}
                </span>
                <span
                    class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent"
                >
                    // preview
                </span>
                <h3
                    class={`mt-2 font-display text-fg group-hover:text-ink transition-colors leading-tight ${big ? "text-3xl md:text-4xl" : "text-xl md:text-2xl"}`}
                >
                    {title}
                </h3>
            </div>

            <div
                class="mt-12 flex items-center text-[10px] font-andesNeueMedium text-ink-soft uppercase tracking-[0.2em]"
            >
                <span class="w-6 h-px bg-ink-30 mr-3"></span>
                Active Status
            </div>
        </div>
    </article>
</li>

<script>
document.querySelectorAll<HTMLElement>('[data-delay]').forEach((el) => {
  el.style.animationDelay = el.dataset.delay + 'ms';
});
</script>
