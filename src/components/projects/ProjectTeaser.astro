---
import ProjectPreviewCard from "./ProjectPreviewCard.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
    projects: any[];
    locale: string;
    t: any;
    plain?: boolean;
}

const { projects, locale, t, plain = false }: Props = Astro.props;
---

<section
    class={plain ? "" : "container mx-auto px-4 md:px-12"}
    aria-labelledby="projects-teaser-heading"
>
    <div class="relative">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-8"
        >
            <div class={plain ? "hidden" : "border-l-2 border-ink pl-6"}>
                <p
                    class="text-ink text-xs md:text-sm font-display uppercase tracking-widest mb-2 animate-fadeIn_2000"
                >
                    {t.currentProjects}
                </p>
                <h2
                    id="projects-teaser-heading"
                    class="text-4xl md:text-6xl font-display text-fg animate-fadeIn_2000"
                >
                    {t.projectsTeaser}
                </h2>
            </div>

            <div class="animate-fadeIn_2200">
                <a
                    href={getRelativeLocaleUrl(locale, "/projects")}
                    class="btn"
                >
                    <span
                        class="text-sm font-andesNeueMedium text-ink group-hover:text-ink transition-colors"
                    >
                        {t.toProjectsLink}
                    </span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 16 16"
                        fill="currentColor"
                        class="h-4 w-4 text-ink transition-transform duration-300 group-hover:translate-x-1"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                            clip-rule="evenodd"></path>
                    </svg>
                </a>
            </div>
        </div>

        <ul class="list-none bento-grid">
            {
                projects.map((p, index) => (
                    <ProjectPreviewCard
                        title={p.title}
                        index={index}
                        big={index === 0}
                    />
                ))
            }
            <li>
                <a
                    href={getRelativeLocaleUrl(locale, "/projects")}
                    class="card card-hover flex items-center justify-center p-8 h-full no-underline group"
                >
                    <span class="font-mono text-xs uppercase tracking-[0.18em] text-ink group-hover:text-accent transition-colors">
                        {t.toProjectsLink} -&gt;
                    </span>
                </a>
            </li>
        </ul>
    </div>
</section>
