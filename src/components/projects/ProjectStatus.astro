---
import { getTranslations } from "../../i18n/index";

interface Props {
    title: string;
    online: boolean;
    finished: boolean;
}
const { title, online, finished }: Props = Astro.props;

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);

const dotColor = online
    ? "bg-ink"
    : finished
      ? "bg-ink-30"
      : "bg-ink-10";
const statusLabel = online
    ? t.statusOnline
    : finished
      ? t.statusOffline
      : t.statusStandby;
---

<div class="mb-2 flex items-center gap-2">
    <span
        class="relative group shrink-0 flex items-center justify-center cursor-default"
    >
        <span
            class={`dot ${dotColor}`}
            aria-label={statusLabel}></span>
        <span
            class="tooltip"
        >
            {statusLabel}
        </span>
    </span>
    <h3 class="font-display text-fg leading-snug">{title}</h3>
</div>
