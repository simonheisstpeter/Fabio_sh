---
// Floating glass pill nav shared by the option pages and the component kits.
import { getTranslations } from "../../../i18n/index";
import GlassMini from "./GlassMini.astro";

interface Props {
    links?: { href: string; text: string; current?: boolean }[];
}
const t = getTranslations("en");
const {
    links = [
        { href: "#projects", text: t.menuProjects, current: true },
        { href: "#about", text: t.menuAbout },
        { href: "/social", text: t.menuSocial },
        { href: "#contact", text: t.menuContact },
    ],
}: Props = Astro.props;
const nav = links;
---

<header class="g-nav g-glass">
    <a class="g-brand" href="/" aria-label="fabio.sh home">
        <GlassMini />
        <span>fabio.sh</span>
    </a>
    <nav aria-label="Main">
        <ul class="g-navlinks">
            {nav.map((l) => <li><a href={l.href} aria-current={l.current ? "page" : undefined}>{l.text}</a></li>)}
        </ul>
    </nav>
    <a class="g-locale" href="/" hreflang="de" aria-label="Sprache: Deutsch">
        <abbr title="Deutsch">DE</abbr>
    </a>
    <button class="g-iconbtn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg data-theme-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg data-theme-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <details class="g-menu">
        <summary class="g-iconbtn" aria-label="Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        </summary>
        <ul class="g-menu-sheet">
            {nav.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
        </ul>
    </details>
</header>

<script>
    const root = document.documentElement;
    // theme toggle: same key as the live site
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
            localStorage.setItem("theme", next);
        } catch {}
    });

</script>
