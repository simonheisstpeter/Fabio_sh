---
interface Props {
    label: string;
}
const { label }: Props = Astro.props;
---

<a
    href="#top"
    id="scroll-top-btn"
    aria-label={label}
    class="fixed bottom-6 right-6 z-50 flex h-10 w-10 items-center justify-center btn-ink opacity-0 pointer-events-none transition-opacity duration-300"
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="h-5 w-5"
        aria-hidden="true"
    >
        <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
</a>

<script>
    const btn = document.getElementById("scroll-top-btn");
    if (btn) {
        const toggle = () => {
            const visible = window.scrollY > 300;
            btn.style.opacity = visible ? "1" : "0";
            btn.style.pointerEvents = visible ? "auto" : "none";
        };
        window.addEventListener("scroll", toggle, { passive: true });
        toggle();

        btn.addEventListener("click", (e) => {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
        });
    }
</script>
