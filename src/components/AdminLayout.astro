---
import "../styles/globals.css";

interface Props {
    title: string;
}
const { title }: Props = Astro.props;

const path = Astro.url.pathname;
const navLink =
    "text-muted2 no-underline text-sm py-1 border-b border-transparent transition-colors hover:text-ink hover:border-ink aria-[current=page]:text-ink aria-[current=page]:border-ink";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light dark" />
        <script is:inline>
            (function () {
                try {
                    var t = localStorage.getItem("theme");
                    if (t !== "dark" && t !== "light") {
                        t = window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                            ? "dark"
                            : "light";
                    }
                    document.documentElement.dataset.theme = t;
                } catch (e) {
                    document.documentElement.dataset.theme = "light";
                }
            })();
        </script>
        <title>{title} – Admin · fabio.sh</title>
        <link rel="icon" href="/carp-streamer.ico" />
        <meta name="robots" content="noindex,nofollow" />
    </head>
    <body
        class="bg-paper text-ink min-h-screen flex flex-col font-andesNeueLight"
    >
        <div class="page-frame" aria-hidden="true"></div>
        <header
            class="bg-paper/95 backdrop-blur-sm text-ink border-b border-ink px-6 flex items-center gap-8 h-14 shrink-0 sticky top-0 z-20"
        >
            <a
                href="/admin"
                class="text-ink font-semibold text-base no-underline"
                >fabio.sh admin</a
            >
            <nav class="flex gap-6 flex-1">
                <ul class="list-none flex gap-6 list-none m-0 p-0">
                    <li>   <a
                    href="/admin"
                    aria-current={path === "/admin" ? "page" : undefined}
                    class={navLink}>Dashboard</a
                ></li>
                    <li>  <a
                    href="/admin/projects"
                    aria-current={path.startsWith("/admin/projects")
                        ? "page"
                        : undefined}
                    class={navLink}>Projects</a
                ></li>
                    <li>   <a
                    href="/admin/courses"
                    aria-current={path.startsWith("/admin/courses")
                        ? "page"
                        : undefined}
                    class={navLink}>Courses</a
                ></li>
                    <li>  <a
                    href="/admin/submissions"
                    aria-current={path.startsWith("/admin/submissions")
                        ? "page"
                        : undefined}
                    class={navLink}>Submissions</a
                ></li>
                    <li>     <a
                    href="/admin/cv"
                    aria-current={path.startsWith("/admin/cv")
                        ? "page"
                        : undefined}
                    class={navLink}>CV</a
                ></li>
                </ul>
            </nav>
            <form action="/api/auth/logout" method="POST" class="ml-auto">
                <button
                    type="submit"
                    class="btn"
                    >Logout</button
                >
            </form>
        </header>
        <main class="flex-1 p-8 max-w-275 w-full mx-auto">
            <slot />
        </main>
    </body>
</html>
