---
import "../styles/globals.css";

interface Props {
    title: string;
}
const { title }: Props = Astro.props;

const path = Astro.url.pathname;
const navLink =
    "text-paper/70 no-underline text-sm py-1 border-b-2 border-transparent transition-colors hover:text-paper hover:border-paper aria-[current=page]:text-paper aria-[current=page]:border-paper";
---

<!doctype html>
<html lang="en" class="pixel-bg">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light" />
        <title>{title} – Admin · fabio.sh</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="robots" content="noindex,nofollow" />
    </head>
    <body
        class="bg-paper text-ink min-h-screen flex flex-col font-sans"
    >
        <header
            class="bg-ink text-paper border-b-2 border-ink px-6 flex items-center gap-8 h-14 shrink-0"
        >
            <a
                href="/admin"
                class="text-paper font-semibold text-base no-underline"
                >fabio.sh admin</a
            >
            <nav class="flex gap-6 flex-1">
                <ul class="flex gap-6 list-none m-0 p-0">
                    <li>   <a
                    href="/admin"
                    aria-current={path === "/admin" ? "page" : undefined}
                    class={navLink}>Dashboard</a
                ></li>
                    <li>  <a
                    href="/admin/projects"
                    aria-current={path.startsWith("/admin/projects")
                        ? "page"
                        : undefined}
                    class={navLink}>Projects</a
                ></li>
                    <li>   <a
                    href="/admin/courses"
                    aria-current={path.startsWith("/admin/courses")
                        ? "page"
                        : undefined}
                    class={navLink}>Courses</a
                ></li>
                    <li>  <a
                    href="/admin/submissions"
                    aria-current={path.startsWith("/admin/submissions")
                        ? "page"
                        : undefined}
                    class={navLink}>Submissions</a
                ></li>
                    <li>     <a
                    href="/admin/cv"
                    aria-current={path.startsWith("/admin/cv")
                        ? "page"
                        : undefined}
                    class={navLink}>CV</a
                ></li>
                </ul>
            </nav>
            <form action="/api/auth/logout" method="POST" class="ml-auto">
                <button
                    type="submit"
                    class="bg-transparent border border-paper/40 text-paper/80 px-3 py-1 text-xs cursor-pointer transition-colors hover:border-paper hover:text-paper"
                    >Logout</button
                >
            </form>
        </header>
        <main class="flex-1 p-8 max-w-275 w-full mx-auto">
            <slot />
        </main>
    </body>
</html>
