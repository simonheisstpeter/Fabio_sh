---
interface Props {
    class?: string;
}

const { class: className = "h-3 w-3" } = Astro.props;
---

<svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
>
    <path d="M7 17 17 7M17 7H8M17 7v9" />
</svg>
