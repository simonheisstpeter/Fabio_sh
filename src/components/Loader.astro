---
interface Props {
    big?: boolean;
}
const { big = false }: Props = Astro.props;
---

<div class={big ? "" : "mr-7 inline-block"} aria-hidden="true">
    <!-- "F" mark: a single letter in a hairline square -->
    <span
        class={big
            ? "inline-flex h-45 w-45 items-center justify-center border border-ink font-extralight text-9xl leading-none"
            : "inline-flex h-8 w-8 translate-y-0.5 items-center justify-center border border-ink font-andesNeueMedium text-sm leading-none"}
        >F</span
    >
    <span class="sr-only">Home</span>
</div>
