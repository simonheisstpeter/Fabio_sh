---
// 3x3 diagonal ramp sample as real tiles, so each tile can pop with a
// stagger (--d) when the parent section head reveals on scroll.
const RAMP = ["#ccfbf1", "#99f6e4", "#5eead4", "#2dd4bf", "#0d9488", "#0f766e"];
const tiles = Array.from({ length: 9 }, (_, i) => {
    const col = i % 3;
    const row = Math.floor(i / 3);
    return { color: RAMP[(row + col) % 6], delay: (row + col) * 60 };
});
---

<span class="mini-mosaic-grid" aria-hidden="true">
    {
        tiles.map((t) => (
            <span style={`background:${t.color};--d:${t.delay}ms`} />
        ))
    }
</span>
