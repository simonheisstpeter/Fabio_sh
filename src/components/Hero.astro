---
import MosaicWord from "./MosaicWord.astro";
const { t, isJa } = Astro.props;

// 6x6 diagonal ramp mosaic for the hero F mark (mistral-style color blocks)
const RAMP = ["#A7F3D0", "#6EE7B7", "#34D399", "#10B981", "#059669", "#047857"];
const tiles = Array.from({ length: 36 }, (_, i) => i);
---

<section class="container mx-auto pt-24 md:pt-40 px-6 md:pl-12 relative overflow-hidden">
    <!-- cursor-reactive pixel field, index hero only -->
    <canvas id="hero-field" class="hero-field" aria-hidden="true"></canvas>
    <div class="relative z-10">
    <!-- mono metadata strip -->
    <div class="meta-row mb-10 animate-fadeIn_2000">
        <span class="flex items-center gap-2">
            <span class="dot dot-live bg-accent"></span>
            {t.statusOnline}
        </span>
        <span class="sep" aria-hidden="true">//</span>
        <span>Vienna, AT [48.2082° N, 16.3738° E]</span>
        <span class="sep" aria-hidden="true">//</span>
        <span><span id="vienna-time">00:00:00</span> CET</span>
    </div>

    <!-- mosaic wordmark: FABIO as a ramp-tile grid (18px language, scaled up) -->
    <div class="animate-line-1">
        <MosaicWord label={t.name} word="FABIO" />
    </div>

    <!-- sticker row: rotated accent label + solid F block + mono taglines -->
    <div class="mt-10 flex flex-wrap items-center gap-6 animate-fadeIn_2200">
        <span class="sticker px-corner">\ digital media &amp; IT</span>
        <span class="f-mosaic px-corner" aria-hidden="true">
            {tiles.map((i) => {
                const col = i % 6;
                const row = Math.floor(i / 6);
                const step = row + col;
                return (
                    <span
                        class="f-tile animate-pop"
                        style={`background:${RAMP[step % 6]};animation-delay:${200 + step * 55}ms`}
                    />
                );
            })}
        </span>
    </div>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap gap-4 animate-fadeIn_2500">
        <a href="#projects" class="btn btn-solid text-sm">{t.menuProjects}</a>
        <a href="#contact" class="btn text-sm">{t.menuContact}</a>
    </div>

    <!-- scroll hint: three staggered chevrons -->
    <div
        class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center text-muted2"
        aria-hidden="true"
    >
        <svg class="h-4 w-4 animate-scroll-hint-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5l5 5 5-5" stroke-linecap="square"/></svg>
        <svg class="h-4 w-4 -mt-2 animate-scroll-hint-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5l5 5 5-5" stroke-linecap="square"/></svg>
        <svg class="h-4 w-4 -mt-2 animate-scroll-hint-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5l5 5 5-5" stroke-linecap="square"/></svg>
    </div>
    </div>
</section>

<script>
    function updateTime() {
        const el = document.getElementById("vienna-time");
        if (!el) return;
        el.textContent = new Date().toLocaleTimeString("en-GB", {
            timeZone: "Europe/Vienna",
            hour12: false,
        });
    }
    updateTime();
    setInterval(updateTime, 1000);
</script>

<script>
    // Cursor-reactive pixel field behind the hero: 18px cells in the emerald
    // ramp light up around the pointer and fade out. Static scatter when
    // prefers-reduced-motion is set. Vanilla canvas, no dependencies.
    document.addEventListener("astro:page-load", () => {
        const canvas = document.getElementById("hero-field") as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.fieldInit) return;
        canvas.dataset.fieldInit = "1";
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const CELL = 18;
        const COLORS = ["#10B981", "#34D399", "#6EE7B7", "#A7F3D0", "#047857"];
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const live = new Map<string, { x: number; y: number; life: number; color: string }>();

        const resize = () => {
            const parent = canvas.parentElement;
            if (!parent) return;
            canvas.width = parent.clientWidth;
            canvas.height = parent.clientHeight;
        };
        resize();
        window.addEventListener("resize", resize);

        const spawn = (px: number, py: number) => {
            const cx = Math.floor(px / CELL);
            const cy = Math.floor(py / CELL);
            for (let dy = -1; dy <= 1; dy++) {
                for (let dx = -1; dx <= 1; dx++) {
                    if (Math.random() > 0.65) continue;
                    live.set(`${cx + dx},${cy + dy}`, {
                        x: (cx + dx) * CELL,
                        y: (cy + dy) * CELL,
                        life: 1,
                        color: COLORS[(Math.random() * COLORS.length) | 0],
                    });
                }
            }
        };

        const hero = canvas.parentElement;
        hero?.addEventListener("pointermove", (e) => {
            const r = hero.getBoundingClientRect();
            spawn(e.clientX - r.left, e.clientY - r.top);
        });

        if (reduced) {
            for (let i = 0; i < 60; i++) {
                spawn(Math.random() * canvas.width, Math.random() * canvas.height);
            }
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (const c of live.values()) {
                ctx.globalAlpha = 0.35;
                ctx.fillStyle = c.color;
                ctx.fillRect(c.x, c.y, CELL - 2, CELL - 2);
            }
            ctx.globalAlpha = 1;
            return;
        }

        const frame = () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (const [key, c] of live) {
                c.life -= 0.02;
                if (c.life <= 0) {
                    live.delete(key);
                    continue;
                }
                ctx.globalAlpha = Math.max(0, c.life) * 0.5;
                ctx.fillStyle = c.color;
                ctx.fillRect(c.x, c.y, CELL - 2, CELL - 2);
            }
            ctx.globalAlpha = 1;
            if (live.size < 120 && Math.random() < 0.3) {
                spawn(Math.random() * canvas.width, Math.random() * canvas.height);
            }
            requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
    });
</script>
