---
const { t, isJa } = Astro.props;
---

<section class="container mx-auto pt-24 md:pt-40 px-6 md:pl-12 relative">
    <!-- mono metadata strip -->
    <div class="meta-row mb-10 animate-fadeIn_2000">
        <span class="flex items-center gap-2">
            <span class="dot bg-ink animate-pulse"></span>
            {t.statusOnline}
        </span>
        <span class="sep" aria-hidden="true">//</span>
        <span>Vienna, AT [48.2082° N, 16.3738° E]</span>
        <span class="sep" aria-hidden="true">//</span>
        <span><span id="vienna-time">00:00:00</span> CET</span>
    </div>

    <h1
        class={`${isJa ? "space-y-4 text-5xl md:space-y-6" : "text-6xl"} w-fit max-w-full font-extralight md:text-[12rem] leading-[0.9] block animate-fadeIn_2000 text-ink relative`}
    >
        <span class="block">{t.name}</span>
        <span class="block text-outline"
            >{t.lastname}<span class="caret animate-blink" aria-hidden="true"></span></span
        >
        <span
            class="block animate-fadeIn_2200 font-mono text-sm md:text-base text-muted2 mt-8 tracking-[0.2em] uppercase"
        >
            \ digital media &amp; IT
        </span>
        <span
            class="block animate-fadeIn_2500 font-mono text-xs md:text-sm text-muted3 mt-3 tracking-[0.2em] uppercase"
        >
            Vienna &middot; Europe
        </span>
    </h1>
</section>

<script>
    function updateTime() {
        const el = document.getElementById("vienna-time");
        if (!el) return;
        el.textContent = new Date().toLocaleTimeString("en-GB", {
            timeZone: "Europe/Vienna",
            hour12: false,
        });
    }
    updateTime();
    setInterval(updateTime, 1000);
</script>
