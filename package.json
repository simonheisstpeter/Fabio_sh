{
  "name": "fabio-sh",
  "version": "2.5.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf node_modules && rm package-lock.json && npm i",
    "seed": "node src/lib/seed.js",
    "backup": "node src/lib/backup.js",
    "reset-admin": "node src/lib/reset-admin.js",
    "fmt": "oxfmt",
    "knip": "knip",
    "migrate": "node src/lib/migrate.js up",
    "migrate:status": "node src/lib/migrate.js status",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "astro": "^7.4.10",
    "astro-mail-obfuscation": "^3.0.1"
  },
  "overrides": {
    "@vercel/blob": "^2.9.0",
    "@vercel/oidc": "^4.0.8",
    "@vercel/cli-config": "^0.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
