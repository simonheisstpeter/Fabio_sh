{
  "name": "fabio-sh",
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf node_modules && rm package-lock.json && npm i",
    "seed": "node src/lib/seed.js",
    "backup": "node src/lib/backup.js",
    "reset-admin": "node src/lib/reset-admin.js",
    "fmt": "oxfmt",
    "knip": "knip",
    "migrate": "node src/lib/migrate.js up",
    "migrate:status": "node src/lib/migrate.js status",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "astro": "^7.2.4",
    "astro-mail-obfuscation": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "knip": "^6.37.0",
    "oxfmt": "^0.68.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
